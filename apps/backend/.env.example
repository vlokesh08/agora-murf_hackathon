# Server
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database. When DATABASE_URL is set, the backend uses that real Postgres
# instance (e.g. Neon, RDS, local). Otherwise it falls back to an embedded
# Postgres-compatible PGlite database on disk at ./var/pgdata, so dev works
# with zero external setup.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
PGLITE_DATA_DIR=./var/pgdata

# Better Auth
BETTER_AUTH_SECRET=dev-only-change-me
BETTER_AUTH_URL=http://localhost:4000

# Filesystem tool sandbox (never points outside this directory)
FS_SANDBOX_DIR=./var/sandbox

# LLM provider (Groq). Without this, responses use a deterministic mock
# instead of a real model, so the app still runs with zero API keys.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth (Calendar + Gmail integration). Required for the "Connect"
# button in Settings / onboarding to do a real OAuth flow instead of a mock toggle.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (github.com/settings/developers). Callback URL:
# {BETTER_AUTH_URL}/api/integrations/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Agora (voice transport — console.agora.io project with App Certificate
# enabled). Required for the voice orb to mint real RTC tokens.
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# Murf (text-to-speech for spoken assistant replies — murf.ai API key).
# MURF_API_KEY=
# MURF_VOICE_ID=en-US-natalie

# Agora Conversational AI Engine (the full managed voice agent — ASR + our
# planner via the custom-LLM callback + Murf TTS — instead of the browser
# Web Speech + manual Murf fallback). Uses the same AGORA_APP_ID/CERTIFICATE
# above (Agora's "token auth" — no separate Customer ID/Secret needed) plus
# MURF_API_KEY. Make sure Conversational AI Engine is enabled for your
# project (console.agora.io — new projects usually have it on by default;
# check under the project's RTC Services / "Conversational AI" settings if
# not). Voice falls back to the hybrid mode automatically when any of these
# three aren't set.
# PUBLIC_BACKEND_URL must be reachable from Agora's cloud — in local dev this
# is your ngrok/cloudflared tunnel URL, e.g. https://xxxx.ngrok-free.app.
# Plain localhost will NOT work here.
# PUBLIC_BACKEND_URL=
# A random shared secret verified on the inbound /api/voice/llm callback so it
# can't be invoked by anyone who finds the URL — generate with e.g. `openssl rand -hex 32`.
# VOICE_WEBHOOK_SECRET=
